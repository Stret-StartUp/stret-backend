# Opcao recomendada: use variaveis separadas para evitar problemas com caracteres
# especiais na senha. O backend monta a DATABASE_URL automaticamente.
MYSQL_DRIVER=mysql+aiomysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=eventrank
MYSQL_USER=eventrank_user
MYSQL_PASSWORD=sua_senha

# Opcao alternativa: informe a URL completa manualmente.
# DATABASE_URL=mysql+aiomysql://eventrank_user:sua_senha@localhost:3306/eventrank?charset=utf8mb4

CREATE_DATABASE_TABLES_ON_STARTUP=false
